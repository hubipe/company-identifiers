{
	"name": "hubipe/company-identifiers",
	"description": "Library aims to validate national identifiers formats and VAT numbers formats of companies and business individuals.",
	"keywords": [
		"company id",
		"companies id",
		"vat id",
		"firmenbuchnummer",
		"IČ",
		"IČO",
		"Handelsregisternummer",
		"Adoszám",
		"REGON",
		"Matična številka",
		"OIB"
	],
	"license": "MIT",
	"authors": [
		{
			"name": "Petr Hubík",
			"homepage": "http://hubik.net"
		}
	],
	"require": {
		"php": "^8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
		"phpstan/phpstan": "^2.1"
	},
	"autoload": {
		"psr-4": { "Hubipe\\CompanyIdentifiers\\": [ "src" ] }
	},
	"autoload-dev": {
		"psr-4": { "Hubipe\\CompanyIdentifiers\\Tests\\": [ "tests" ] }
	}
}
